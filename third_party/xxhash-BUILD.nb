static_library("xxhash"):
    toolchain_include = [
        "toolchains/OBJCXX.json",
        "toolchains/CXX.json",
        "toolchains/C.json",
    ]
    sources = ["third_party/xxhash/xxhash.c"]
    cflags = [
        "-std=c11",
        "-O3",
        "-march=native",
    ]

    ldflags = [
        "-fuse-ld=/opt/homebrew/opt/lld/bin/ld64.lld",
    ]
