cxx = /opt/homebrew/opt/llvm/bin/clang++
cflags = -std=c++23 -O3 -march=native -mtune=native -flto=full -fstrict-aliasing -fomit-frame-pointer -fwhole-program-vtables -fvirtual-function-elimination -fstrict-vtable-pointers -fprofile-instr-use=/Users/ninjakiki/Dev/nightbuild/nightbuild.profdata -Wno-profile-instr-unprofiled -Iinclude -I../third_party/xxhash
ldflags = -flto=full -fuse-ld=/opt/homebrew/opt/lld/bin/ld64.lld -Wl,--icf=safe
libs = -framework CoreServices

rule cxx
  command = $cxx $cflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule cc
  command = /opt/homebrew/opt/llvm/bin/clang -std=c11 -O3 -march=native -mtune=native -fstrict-aliasing -fomit-frame-pointer -I../third_party/xxhash -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule archive
  command = /usr/bin/ar rcs $out $in

rule link
  command = $cxx $ldflags $in $libs -o $out

build obj/main.o: cxx ../src/main.cpp
build obj/cli.o: cxx ../src/cli.cpp
build obj/toml.o: cxx ../src/toml.cpp
build obj/scheduler.o: cxx ../src/scheduler.cpp
build obj/fsevents.o: cxx ../src/fsevents.cpp
build obj/compile_commands.o: cxx ../src/compile_commands.cpp
build obj/xxhash.o: cc ../third_party/xxhash/xxhash.c
build libxxhash.a: archive obj/xxhash.o
build nightbuild: link obj/main.o obj/cli.o obj/toml.o obj/scheduler.o obj/fsevents.o obj/compile_commands.o libxxhash.a

default nightbuild
