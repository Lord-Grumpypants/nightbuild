executable("test"):
    toolchain_include = [
        "toolchains/CXX.json",
    ]
    sources = [
        "tests/main.cpp",
        "src/remote/digest.cpp",
    ]
    include_dirs = ["src/remote"]
    cxxflags = [
        "-std=c++23",
        "-O3",
    ]

    if debug:
        cxxflags += "-g"

executable("remote-capabilities"):
    toolchain_include = [
        "toolchains/CXX.json",
    ]
    sources = [
        "src/remote/capabilities_main.cpp",
        "src/remote/client.cpp",
    ]
    include_dirs = [
        "src/remote",
        "src/remote/generated",
        "build/reapi/grpc/include",
        "build/reapi/grpc",
        "/opt/homebrew/include",
    ]
    cxxflags = [
        "-std=c++23",
        "-O3",
    ]
    library_dirs = ["/opt/homebrew/lib"]
    deps = ["nightbuild_reapi", "grpc"]
    frameworks = [
        "Security",
        "CoreFoundation",
        "SystemConfiguration",
    ]
