project("NightBuild")

default = [
    "nightbuild",
    "test",
]

import "third_party/BUILD.nb"
import "third_party/grpc.BUILD.nb"
import "third_party/reapi.generated.BUILD.nb"

declare_args("debug"):
    default = false

executable("nightbuild"):
    toolchain_include = [
        "toolchains/OBJCXX.json",
        "toolchains/CXX.json",
        "toolchains/C.json",
    ]

    sources = [
        "src/main.cpp",
        "src/cli.cpp",
        "src/toml.cpp",
        "src/scheduler.cpp",
        "src/fsevents.cpp",
        "src/compile_commands.cpp",
        "src/remote/digest.cpp",
        "src/ui/license_window.mm",
    ]

    include_dirs = [
        "include",
        "src/remote",
        "third_party/xxhash",
    ]

    objcxxflags = ["-std=c++23", "-O3", "-fno-objc-msgsend-class-selector-stubs"]

    cxxflags = [
        "-std=c++23",
        "-O3",
        "-march=native",
        "-mtune=native",
        "-flto=full",
        "-fstrict-aliasing",
        "-fomit-frame-pointer",
        "-fwhole-program-vtables",
        "-fvirtual-function-elimination",
        "-fstrict-vtable-pointers",
        "-fprofile-instr-use=nightbuild.profdata",
        "-fno-rtti",
        "-fno-unwind-tables",
        "-Wno-profile-instr-unprofiled",
    ]

    if debug:
        cxxflags += "-g"

    pkg_config = []

    ldflags = [
        "-flto=full",
        "-fuse-ld=/opt/homebrew/opt/lld/bin/ld64.lld",
        "-Wl,--icf=safe",
        "-Wl,-dead_strip",
    ]

    library_dirs = []

    libraries = []

    frameworks = [
        "CoreServices",
        "AppKit",
    ]

    deps = ["xxhash"]


executable("nightbuild-pgo"):
    toolchain_include = [
        "toolchains/OBJCXX.json",
        "toolchains/CXX.json",
        "toolchains/C.json",
    ]

    sources = [
        "src/main.cpp",
        "src/cli.cpp",
        "src/toml.cpp",
        "src/scheduler.cpp",
        "src/fsevents.cpp",
        "src/compile_commands.cpp",
        "src/remote/digest.cpp",
        "src/ui/license_window.mm",
    ]

    include_dirs = [
        "include",
        "src/remote",
        "third_party/xxhash",
    ]

    objcxxflags = ["-std=c++23", "-O3", "-fno-objc-msgsend-class-selector-stubs"]

    cxxflags = [
        "-std=c++23",
        "-O3",
        "-march=native",
        "-mtune=native",
        "-flto=full",
        "-fstrict-aliasing",
        "-fomit-frame-pointer",
        "-fprofile-instr-generate",
    ]

    if debug:
        cxxflags += "-g"

    pkg_config = []

    ldflags = [
        "-fprofile-instr-generate",
        "-fuse-ld=/opt/homebrew/opt/lld/bin/ld64.lld",
    ]

    library_dirs = [
        "/opt/homebrew/opt/llvm/lib/clang/23/lib/darwin",
    ]

    libraries = [
        "clang_rt.profile_osx",
    ]

    frameworks = [
        "CoreServices",
        "AppKit",
    ]

    deps = ["xxhash"]

